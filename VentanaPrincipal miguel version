        contentPane.setBorder(new EmptyBorder(10, 10, 10, 10));
        setContentPane(contentPane);
        contentPane.setLayout(new BorderLayout(10, 10));

        // NORTE
        JPanel panelTitulo = new JPanel(new BorderLayout());
        JLabel lblTitulo = new JLabel("DISEÑANDO REGIONES DE UN PAÍS", JLabel.CENTER);
        lblTitulo.setFont(lblTitulo.getFont().deriveFont(18.0f));
        panelTitulo.add(lblTitulo, BorderLayout.CENTER);

        JButton btnCargarArchivo = new JButton("Cargar desde Archivo (.txt)");
        panelTitulo.add(btnCargarArchivo, BorderLayout.EAST);
        contentPane.add(panelTitulo, BorderLayout.NORTH);

        // CENTRO
        JPanel panelCentral = new JPanel(new GridLayout(1, 2, 10, 0));
        contentPane.add(panelCentral, BorderLayout.CENTER);

        // IZQUIERDA: CONTROLES
        JPanel panelIzquierdo = new JPanel(new BorderLayout(10, 10));
        panelCentral.add(panelIzquierdo);

        JScrollPane scrollControles = new JScrollPane();
        JPanel panelCarga = new JPanel();
        panelCarga.setLayout(new BoxLayout(panelCarga, BoxLayout.Y_AXIS));
        scrollControles.setViewportView(panelCarga);
        panelIzquierdo.add(scrollControles, BorderLayout.CENTER);

        // 1. Vértices
        JPanel panelCiudad = new JPanel(new GridLayout(4, 2, 5, 5));
        panelCiudad.setBorder(new TitledBorder("1. Cargar Provincia / Ciudad"));

        panelCiudad.add(new JLabel("Nombre:"));
        txtNombre = new JTextField();
        panelCiudad.add(txtNombre);

        panelCiudad.add(new JLabel("Latitud:"));
        txtLatitud = new JTextField();
        panelCiudad.add(txtLatitud);

        panelCiudad.add(new JLabel("Longitud:"));
        txtLongitud = new JTextField();
        panelCiudad.add(txtLongitud);

        JButton botonAgregarCiudad = new JButton("Agregar Ciudad");
        panelCiudad.add(new JLabel(""));
        panelCiudad.add(botonAgregarCiudad);
        panelCarga.add(panelCiudad);

        // 2. Lista
        JPanel panelLista = new JPanel(new BorderLayout(5, 5));
        panelLista.setBorder(new TitledBorder("Ciudades Cargadas"));

        modeloCiudades = new DefaultListModel<>();
        listaCiudades = new JList<>(modeloCiudades);
        JScrollPane scrollLista = new JScrollPane(listaCiudades);
        scrollLista.setPreferredSize(new Dimension(0, 80));
        panelLista.add(scrollLista, BorderLayout.CENTER);
        panelCarga.add(panelLista);

        // 3. Aristas
        JPanel panelConexion = new JPanel(new GridLayout(4, 2, 5, 5));
        panelConexion.setBorder(new TitledBorder("2. Cargar Similaridad / Conexión"));

