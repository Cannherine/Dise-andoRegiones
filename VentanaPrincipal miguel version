    private void agregarCiudad() {
        String nombre = txtNombre.getText().trim();
        String latStr = txtLatitud.getText().trim();
        String lonStr = txtLongitud.getText().trim();

        if (nombre.isEmpty() || latStr.isEmpty() || lonStr.isEmpty()) {
            JOptionPane.showMessageDialog(this, "Complete todos los campos.");
            return;
        }

        try {
            double lat = Double.parseDouble(latStr);
            double lon = Double.parseDouble(lonStr);

            Vertice ciudad = new Vertice(nombre, lat, lon);
            boolean agregado = grafo.agregarVertice(ciudad);

            if (agregado) {
                modeloCiudades.addElement(nombre);
                comboCiudad1.addItem(ciudad);
                comboCiudad2.addItem(ciudad);

                Coordinate coord = new Coordinate(lat, lon);
                MapMarkerDot marker = new MapMarkerDot(nombre, coord);
                marker.getStyle().setBackColor(Color.GRAY);
                marker.getStyle().setColor(Color.BLACK);
                mapa.addMapMarker(marker);
                mapa.setDisplayPosition(coord, mapa.getZoom());

                txtNombre.setText("");
                txtLatitud.setText("");
                txtLongitud.setText("");
            } else {
                JOptionPane.showMessageDialog(this, "La ciudad ya existe.");
            }
        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(this, "Latitud y Longitud deben ser números decimales válidos.");
        }
    }

    private void agregarConexion() {
        Vertice origen = (Vertice) comboCiudad1.getSelectedItem();
        Vertice destino = (Vertice) comboCiudad2.getSelectedItem();
        String pesoStr = txtPeso.getText().trim();

        if (origen == null || destino == null || pesoStr.isEmpty()) {
            JOptionPane.showMessageDialog(this, "Seleccione ambas ciudades e ingrese el peso.");
            return;
        }

        try {
            int peso = Integer.parseInt(pesoStr);
            Arista arista = new Arista(origen, destino, peso);

            boolean agregado = grafo.agregarArista(arista);
            if (agregado) {
                dibujarLineaMapa(origen, destino, Color.LIGHT_GRAY);
                txtPeso.setText("");
            } else {
                JOptionPane.showMessageDialog(this, "No se pudo agregar la conexión.");
            }
        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(this, "El peso debe ser un número entero.");
        }
    }

    private void ejecutarRegionalizacion() {
        int k = (Integer) spinnerK.getValue();
        int totalVertices = grafo.obtenerVertice().size();

        if (totalVertices == 0) {
            JOptionPane.showMessageDialog(this, "Debe cargar ciudades antes de ejecutar.");
            return;
        }

        if (k <= 0 || k > totalVertices) {
            JOptionPane.showMessageDialog(this, "K debe estar entre 1 y " + totalVertices + ".");
            return;
        }

        try {
            List<List<Vertice>> regiones = TeoremaKruskal.generarRegiones(grafo, k);

            mapa.removeAllMapMarkers();

            StringBuilder sb = new StringBuilder();

            for (int i = 0; i < regiones.size(); i++) {
                List<Vertice> region = regiones.get(i);
                Color colorRegion = COLORES_REGIONES[i % COLORES_REGIONES.length];

                sb.append("REGICÓN ").append(i + 1).append(":\n");

                for (Vertice v : region) {
                    sb.append(" • ").append(v.getNombre()).append("\n");

                    Coordinate coord = new Coordinate(v.getLatitud(), v.getLongitud());
                    MapMarkerDot marker = new MapMarkerDot(v.getNombre() + " (R" + (i + 1) + ")", coord);
                    marker.getStyle().setBackColor(colorRegion);
                    marker.getStyle().setColor(Color.BLACK);
                    mapa.addMapMarker(marker);
                }
                sb.append("\n");
            }

            txtResumenRegiones.setText(sb.toString());
            JOptionPane.showMessageDialog(this, "Se han generado " + regiones.size() + " regiones de forma exitosa.");

        } catch (Exception ex) {
            JOptionPane.showMessageDialog(this, "Error al calcular las regiones: " + ex.getMessage());
        }
    }

    private void cargarDesdeArchivo() {
        JFileChooser fileChooser = new JFileChooser();
        int seleccion = fileChooser.showOpenDialog(this);

        if (seleccion == JFileChooser.APPROVE_OPTION) {
            File archivo = fileChooser.getSelectedFile();
            try (BufferedReader br = new BufferedReader(new FileReader(archivo))) {
                String linea;
                while ((linea = br.readLine()) != null) {
                    if (linea.trim().isEmpty() || linea.startsWith("#")) continue;
                    String[] datos = linea.split(",");
                    if (datos[0].trim().equalsIgnoreCase("CIUDAD") || datos[0].trim().equalsIgnoreCase("PROVINCIA")) {
                        String nombre = datos[1].trim();
                        double lat = Double.parseDouble(datos[2].trim());
                        double lon = Double.parseDouble(datos[3].trim());

                        Vertice v = new Vertice(nombre, lat, lon);
                        if (grafo.agregarVertice(v)) {
                            modeloCiudades.addElement(nombre);
                            comboCiudad1.addItem(v);
                            comboCiudad2.addItem(v);
                            mapa.addMapMarker(new MapMarkerDot(nombre, new Coordinate(lat, lon)));
                        }
                    } else if (datos[0].trim().equalsIgnoreCase("CONEXION")) {
                        Vertice v1 = buscarVerticePorNombre(datos[1].trim());
                        Vertice v2 = buscarVerticePorNombre(datos[2].trim());
                        int peso = Integer.parseInt(datos[3].trim());

                        if (v1 != null && v2 != null) {
                            Arista a = new Arista(v1, v2, peso);
                            if (grafo.agregarArista(a)) {
                                dibujarLineaMapa(v1, v2, Color.LIGHT_GRAY);
                            }
                        }
                    }
                }
                JOptionPane.showMessageDialog(this, "Archivo cargado correctamente.");
            } catch (Exception ex) {
                JOptionPane.showMessageDialog(this, "Error al leer el archivo: " + ex.getMessage());
            }
        }
    }

    private Vertice buscarVerticePorNombre(String nombre) {
        for (Vertice v : grafo.obtenerVertice()) {
            if (v.getNombre().equalsIgnoreCase(nombre)) return v;
        }
        return null;
    }

    private void dibujarLineaMapa(Vertice v1, Vertice v2, Color color) {
        Coordinate c1 = new Coordinate(v1.getLatitud(), v1.getLongitud());
        Coordinate c2 = new Coordinate(v2.getLatitud(), v2.getLongitud());
        List<Coordinate> puntos = new ArrayList<>(Arrays.asList(c1, c2, c2));

        MapPolygonImpl linea = new MapPolygonImpl(puntos);
        linea.getStyle().setColor(color);
        linea.getStyle().setBackColor(color);
        mapa.addMapPolygon(linea);
    }
}
